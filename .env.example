# Configuración del despliegue.
#
# Copiar como `.env` junto a `server.js`. Lo que se ponga aquí pisa lo que trae
# compilado la aplicación; lo que se deje comentado conserva ese valor.
#
# El servidor lo lee EN CADA PETICIÓN de `config.json`: se edita, se recarga la
# página y ya apunta a otro sitio. No hace falta reiniciar el proceso ni volver
# a compilar.
#
# Una variable exportada en el entorno real gana sobre este archivo.

# Servicios de sincronización y autenticación (Node).
#API_URL=https://vtmobileplus.visitrack.com

# API de la plataforma Visitrack (.NET).
#PLATFORM_URL=https://api.visitrack.com

# Servidor de archivos de la plataforma. Solo como respaldo.
#BINARIES_URL=https://and.visitrack.com/WebResource.aspx

# Backend local, para trabajar contra la máquina de desarrollo.
# Con USE_LOCAL_API=true todas las llamadas van a LOCAL_API_URL.
#LOCAL_API_URL=http://localhost:100
#USE_LOCAL_API=false

# Segundos antes de dar por perdida una petición.
#REQUEST_TIMEOUT=30

# Cada cuántos minutos sincroniza sola la aplicación.
#SYNC_INTERVAL_MINUTES=15

# Puerto del servidor estático. No viaja al navegador.
#PORT=3000
